{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          },
          {
            "command": "${CLAUDE_PROJECT_DIR}/scripts/beads-push.sh SessionStart; ${CLAUDE_PROJECT_DIR}/scripts/beads-doctor.sh --hook",
            "type": "command",
            "statusMessage": "Pushing beads issue data and checking beads wiring...",
            "timeout": 140
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/scripts/beads-push.sh SessionEnd",
            "type": "command",
            "statusMessage": "Pushing beads issue data...",
            "timeout": 130
          }
        ]
      }
    ]
  }
}