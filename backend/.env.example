# Node.js Backend Environment Variables

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://habituser:habitpass@localhost:5432/habitcraft

# Frontend
FRONTEND_URL=http://localhost:3100

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
# Note: Token expiration times are hardcoded in routes/auth.js (access: 15m, refresh: 7d)

# Reverse proxy
# Number of proxies in front of this service; decides how much of
# X-Forwarded-For becomes req.ip, which every IP rate limiter keys on.
# Defaults to 1 (Cloud Run with a domain mapping). Never set this to true --
# see backend/config/proxy.js and AUTHENTICATION.md.
TRUSTED_PROXY_HOPS=1
