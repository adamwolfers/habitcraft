# Beads issue-tracker sync after a checkout.
#
# husky owns the single hooks directory (core.hooksPath=.husky/_), leaving
# .git/hooks/ and .beads/hooks/ inert -- see habitcraft-8t8. Do NOT source
# '_/h': the stub .husky/_/post-checkout does that and invokes this file.
#
# "$@" matters here -- git passes prev-HEAD, new-HEAD and a branch-vs-file
# flag, and bd needs them to tell a branch switch from a file checkout.
#
# Guards mirror .husky/post-merge: BEADS_HOOK_TIMEOUT bounds a hung bd (124 is
# timeout's own code; timeout is absent on stock macOS), and the exit-3 check
# is defensive only -- bd 1.1.0 embedded returns 0 for every "no database"
# state tested, so it guards a case this version does not produce.
# '|| _bd_exit=$?' is load-bearing --
# husky runs this under `sh -e`, which would abort on a non-zero status before
# the guards below could read it.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_exit=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run post-checkout "$@" || _bd_exit=$?
    if [ "$_bd_exit" -eq 124 ]; then
      echo >&2 "beads: hook 'post-checkout' timed out after ${_bd_timeout}s — continuing without beads"
      _bd_exit=0
    fi
  else
    bd hooks run post-checkout "$@" || _bd_exit=$?
  fi
  if [ "$_bd_exit" -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'post-checkout'"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
fi
