# Run bd (beads) pre-commit hook for issue tracking sync
if command -v bd >/dev/null 2>&1; then
  bd hook pre-commit
fi

# Run lint-staged for mobile app formatting
MOBILE_DIR="$(git rev-parse --show-toplevel)/frontends/mobile"
if [ -f "$MOBILE_DIR/node_modules/.bin/lint-staged" ]; then
  cd "$MOBILE_DIR" && npx lint-staged
fi
