# dbmate configuration
# https://github.com/amacneil/dbmate

# dbmate is the authoring tool here (`dbmate new <name>`). Migrations are
# APPLIED by `habitcraft migrate`, which embeds this directory (server/schema/);
# see db/README.md.

# Migration files location
--migrations-dir=server/schema/migrations

# Schema dump file (generated by scripts/schema-dump.sh, never by hand)
--schema-file=server/schema/schema.sql

# Table to track applied migrations
--migrations-table=schema_migrations

# Wait for database to be ready before running migrations
--wait

# Timeout for waiting (in seconds)
--wait-timeout=60s

# Don't dump schema after migrations (we'll do this explicitly)
--no-dump-schema
