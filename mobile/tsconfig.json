{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/screens/*": [
        "src/screens/*"
      ],
      "@/hooks/*": [
        "src/hooks/*"
      ],
      "@/lib/*": [
        "src/lib/*"
      ],
      "@/context/*": [
        "src/context/*"
      ],
      "@/navigation/*": [
        "src/navigation/*"
      ],
      "@/theme/*": [
        "src/theme/*"
      ],
      "@/types/*": [
        "src/types/*"
      ]
    },
    "types": [
      "jest",
      "@testing-library/react-native"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
